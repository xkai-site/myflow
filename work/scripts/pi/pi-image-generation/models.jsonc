{
  "version": 1,
  "providers": [
    {
      "id": "openai", "name": "OpenAI Codex", "adapter": "openai-codex-images",
      "auth": { "type": "provider", "providerId": "openai-codex" },
      "defaultModel": "openai-flare-26"
    },
    {
      "id": "qwen", "name": "Qwen Token Plan CN", "adapter": "ali-wan-images",
      "auth": { "type": "api-key", "env": "PI_IMAGE_QWEN_API_KEY", "fallbackProviderId": "qwen-token-plan-cn" },
      "defaultModel": "wan"
    }
  ],
  // Platform JSON /images/edits: up to 16 images; each image_url <= 20,971,520 characters.
  // For the configured MIME types: floor((20,971,520 - data URL prefix length) / 4) * 3 = 15,728,622 bytes.
  // https://developers.openai.com/api/reference/resources/images/methods/edit
  "models": [
    {
      // Legacy selector: do not remap this key when changing the provider default.
      "key": "openai", "id": "gpt-image-2", "name": "GPT Image 2", "provider": "openai",
      "description": "兼容已有工作流",
      "tasks": ["generate", "edit"],
      "prompt": { "maxChars": 32000 },
      "inputImages": { "maximum": 16, "maxBytes": 15728622, "maxDataUrlLength": 20971520, "mimeTypes": ["image/png", "image/jpeg", "image/webp", "image/bmp"] },
      "size": {
        "generate": {
          "default": "auto",
          "options": [
            { "value": "auto", "label": "自动" },
            { "value": "1024x1024", "label": "正方形" },
            { "value": "1536x1024", "label": "横向" },
            { "value": "1024x1536", "label": "纵向" }
          ],
          "custom": { "separator": "x", "minPixels": 655360, "maxPixels": 8294400, "maxSide": 3840, "maxRatio": 3, "multipleOf": 16 }
        }
      },
      "quality": {
        "default": "auto",
        "options": [
          { "value": "auto", "label": "自动" },
          { "value": "low", "label": "低" },
          { "value": "medium", "label": "中" },
          { "value": "high", "label": "高" }
        ]
      }
    },
    {
      "key": "wan", "id": "wan2.7-image", "name": "Wan 2.7 Image", "provider": "qwen",
      "description": "基础生图与参考图编辑",
      "tasks": ["generate", "edit"],
      "prompt": { "maxChars": 5000 },
      "inputImages": { "maximum": 9, "maxBytes": 20971520, "mimeTypes": ["image/png", "image/jpeg", "image/webp", "image/bmp"] },
      "size": {
        "generate": {
          "default": "2K",
          "options": [{ "value": "1K", "label": "1K" }, { "value": "2K", "label": "2K" }],
          "custom": { "separator": "*", "minPixels": 589824, "maxPixels": 4194304, "maxRatio": 8, "multipleOf": 1 }
        }
      }
    },
    {
      "key": "wan-pro", "id": "wan2.7-image-pro", "name": "Wan 2.7 Image Pro", "provider": "qwen",
      "description": "4K 生图，编辑最高 2K",
      "tasks": ["generate", "edit"],
      "prompt": { "maxChars": 5000 },
      "inputImages": { "maximum": 9, "maxBytes": 20971520, "mimeTypes": ["image/png", "image/jpeg", "image/webp", "image/bmp"] },
      "size": {
        "generate": {
          "default": "2K",
          "options": [{ "value": "1K", "label": "1K" }, { "value": "2K", "label": "2K" }, { "value": "4K", "label": "4K" }],
          "custom": { "separator": "*", "minPixels": 589824, "maxPixels": 16777216, "maxRatio": 8, "multipleOf": 1 }
        },
        // Editing has a lower size limit.
        "edit": {
          "default": "2K",
          "options": [{ "value": "1K", "label": "1K" }, { "value": "2K", "label": "2K" }],
          "custom": { "separator": "*", "minPixels": 589824, "maxPixels": 4194304, "maxRatio": 8, "multipleOf": 1 }
        }
      }
    },
    {
      // Enabled in this catalog; backend access depends on the authenticated account.
      // https://developers.openai.com/api/docs/models/gpt-image-2.5-sunburst
      "key": "openai-sunburst", "id": "gpt-image-2.5-sunburst", "name": "GPT Image 2.5 Sunburst", "provider": "openai",
      "description": "上代精细生成与编辑",
      // Platform generation/edit semantics; Codex channel acceptance is not online-verified.
      "outputFormat": { "default": "png", "options": [{ "value": "png", "label": "PNG" }, { "value": "jpeg", "label": "JPEG" }, { "value": "webp", "label": "WebP" }] },
      "background": { "default": "auto", "options": [{ "value": "auto", "label": "自动" }, { "value": "opaque", "label": "不透明" }, { "value": "transparent", "label": "透明" }] },
      "enabled": true,
      "tasks": ["generate", "edit"],
      "prompt": { "maxChars": 32000 },
      "inputImages": { "maximum": 16, "maxBytes": 15728622, "maxDataUrlLength": 20971520, "mimeTypes": ["image/png", "image/jpeg", "image/webp", "image/bmp"] },
      "size": {
        "generate": {
          "default": "auto",
          "options": [
            { "value": "auto", "label": "自动" },
            { "value": "1024x1024", "label": "正方形" },
            { "value": "1536x1024", "label": "横向" },
            { "value": "1024x1536", "label": "纵向" }
          ],
          "custom": { "separator": "x", "minPixels": 655360, "maxPixels": 8294400, "maxSide": 3840, "maxRatio": 3, "multipleOf": 16 }
        }
      },
      "quality": {
        "default": "auto",
        "options": [
          { "value": "auto", "label": "自动" },
          { "value": "low", "label": "低" },
          { "value": "medium", "label": "中" },
          { "value": "high", "label": "高" },
          { "value": "xhigh", "label": "超高" },
          { "value": "max", "label": "最高" }
        ]
      }
    },
    {
      // https://developers.openai.com/api/docs/models/gpt-image-2.5-flare
      "key": "openai-flare", "id": "gpt-image-2.5-flare", "name": "GPT Image 2.5 Flare", "provider": "openai",
      "description": "上代快速生成",
      // Platform generation/edit semantics; Codex channel acceptance is not online-verified.
      "outputFormat": { "default": "png", "options": [{ "value": "png", "label": "PNG" }, { "value": "jpeg", "label": "JPEG" }, { "value": "webp", "label": "WebP" }] },
      "background": { "default": "auto", "options": [{ "value": "auto", "label": "自动" }, { "value": "opaque", "label": "不透明" }, { "value": "transparent", "label": "透明" }] },
      "enabled": true,
      "tasks": ["generate", "edit"],
      "prompt": { "maxChars": 32000 },
      "inputImages": { "maximum": 16, "maxBytes": 15728622, "maxDataUrlLength": 20971520, "mimeTypes": ["image/png", "image/jpeg", "image/webp", "image/bmp"] },
      "size": {
        "generate": {
          "default": "auto",
          "options": [
            { "value": "auto", "label": "自动" },
            { "value": "1024x1024", "label": "正方形" },
            { "value": "1536x1024", "label": "横向" },
            { "value": "1024x1536", "label": "纵向" }
          ],
          "custom": { "separator": "x", "minPixels": 655360, "maxPixels": 8294400, "maxSide": 3840, "maxRatio": 3, "multipleOf": 16 }
        }
      },
      "quality": {
        "default": "auto",
        "options": [
          { "value": "auto", "label": "自动" },
          { "value": "low", "label": "低" },
          { "value": "medium", "label": "中" },
          { "value": "high", "label": "高" },
          { "value": "xhigh", "label": "超高" },
          { "value": "max", "label": "最高" }
        ]
      }
    },
    {
      // https://developers.openai.com/api/docs/guides/image-prompting
      // 2.6 confirms multiples of 16 and ratio <= 3; pixel/edge caps retain the documented 2/2.5 range pending 2.6-specific confirmation.
      "key": "openai-sunburst-26", "id": "gpt-image-2.6-sunburst", "name": "GPT Image 2.6 Sunburst", "provider": "openai",
      "description": "精细创作与精确编辑",
      // https://developers.openai.com/api/docs/guides/image-prompting
      // Platform generation/edit semantics; Codex channel acceptance is not online-verified.
      "outputFormat": { "default": "png", "options": [{ "value": "png", "label": "PNG" }, { "value": "jpeg", "label": "JPEG" }, { "value": "webp", "label": "WebP" }] },
      "background": { "default": "auto", "options": [{ "value": "auto", "label": "自动" }, { "value": "opaque", "label": "不透明" }, { "value": "transparent", "label": "透明" }] },
      "enabled": true,
      "tasks": ["generate", "edit"],
      "prompt": { "maxChars": 32000 },
      "inputImages": { "maximum": 16, "maxBytes": 15728622, "maxDataUrlLength": 20971520, "mimeTypes": ["image/png", "image/jpeg", "image/webp", "image/bmp"] },
      "size": {
        "generate": {
          "default": "auto",
          "options": [
            { "value": "auto", "label": "自动" },
            { "value": "1024x1024", "label": "正方形" },
            { "value": "1536x1024", "label": "横向" },
            { "value": "1024x1536", "label": "纵向" }
          ],
          "custom": { "separator": "x", "minPixels": 655360, "maxPixels": 8294400, "maxSide": 3840, "maxRatio": 3, "multipleOf": 16 }
        }
      },
      "quality": {
        "default": "auto",
        "options": [
          { "value": "auto", "label": "自动" },
          { "value": "low", "label": "低" },
          { "value": "medium", "label": "中" },
          { "value": "high", "label": "高" },
          { "value": "xhigh", "label": "超高" },
          { "value": "max", "label": "最高" }
        ]
      },
      "complexity": {
        "default": "high",
        "options": [
          { "value": "low", "label": "低" },
          { "value": "medium", "label": "中" },
          { "value": "high", "label": "高" }
        ]
      }
    },
    {
      // https://developers.openai.com/api/docs/models/gpt-image-2.6-flare
      // Same Platform JSON input limits; pixel/edge caps await 2.6-specific confirmation.
      "key": "openai-flare-26", "id": "gpt-image-2.6-flare", "name": "GPT Image 2.6 Flare", "provider": "openai",
      "description": "快速生成与日常迭代",
      // Platform generation/edit semantics; Codex channel acceptance is not online-verified.
      "outputFormat": { "default": "png", "options": [{ "value": "png", "label": "PNG" }, { "value": "jpeg", "label": "JPEG" }, { "value": "webp", "label": "WebP" }] },
      "background": { "default": "auto", "options": [{ "value": "auto", "label": "自动" }, { "value": "opaque", "label": "不透明" }, { "value": "transparent", "label": "透明" }] },
      "enabled": true,
      "tasks": ["generate", "edit"],
      "prompt": { "maxChars": 32000 },
      "inputImages": { "maximum": 16, "maxBytes": 15728622, "maxDataUrlLength": 20971520, "mimeTypes": ["image/png", "image/jpeg", "image/webp", "image/bmp"] },
      "size": {
        "generate": {
          "default": "auto",
          "options": [
            { "value": "auto", "label": "自动" },
            { "value": "1024x1024", "label": "正方形" },
            { "value": "1536x1024", "label": "横向" },
            { "value": "1024x1536", "label": "纵向" }
          ],
          "custom": { "separator": "x", "minPixels": 655360, "maxPixels": 8294400, "maxSide": 3840, "maxRatio": 3, "multipleOf": 16 }
        }
      },
      "quality": {
        "default": "auto",
        "options": [
          { "value": "auto", "label": "自动" },
          { "value": "low", "label": "低" },
          { "value": "medium", "label": "中" },
          { "value": "high", "label": "高" },
          { "value": "xhigh", "label": "超高" },
          { "value": "max", "label": "最高" }
        ]
      },
      "complexity": {
        "default": "high",
        "options": [
          { "value": "low", "label": "低" },
          { "value": "medium", "label": "中" },
          { "value": "high", "label": "高" }
        ]
      }
    }
  ]
}
